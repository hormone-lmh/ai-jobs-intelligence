# 复制为 .env 后按需修改。路径统一用正斜杠，避免反斜杠转义问题。
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# 留空使用项目目录下的默认数据库；不绑定开发者的磁盘路径。
# 当前后端实际读取 DATABASE_URL 和 JOBS_RAW_DIR，其余路径为旧版预留。
JOBS_RAW_DIR=
DATABASE_URL=
# 本地 MySQL 示例（需预先建库或运行迁移脚本）：
# DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/ai_jobs_intelligence?charset=utf8mb4
DATA_DIR=
RAW_DIR=
LOG_DIR=
EXPORT_DIR=
BROWSER_PROFILE_DIR=

# 日志
LOG_LEVEL=INFO

# 大模型增强（可选）。留空即纯规则模式，统计口径不变，仅召回率下降。
LLM_ENABLED=false
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 采集开关。关闭后系统仍可用，只做导入与手动录入。
COLLECT_ENABLED=true
COLLECT_MIN_INTERVAL_SECONDS=10
COLLECT_MAX_ROUNDS_PER_DAY=1
